PORT=3001
# Comma-separated. Include the public landing site so its contact form can POST here.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3003
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPERADMIN_USER_ID=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-this-password


# Optional Zoom Server-to-Server OAuth integration
ZOOM_ACCOUNT_ID=your_account_id
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret

# Optional Resend email integration (notifications go in-app only if unset;
# the landing site's contact form cannot deliver messages without it)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=WAFA <notifications@yourdomain.com>
# Optional: a monitored inbox replies go to (helps deliverability)


# Required for the Zoom webhook (POST /api/zoom/webhook): the "Secret Token"
# from your Zoom app's Feature > Event Subscriptions page.
ZOOM_SECRET_TOKEN=your_zoom_webhook_secret_token

# Cloudflare Turnstile captcha for the public contact form. When set, every
# contact submission must carry a valid token (pair it with the landing site's
# NEXT_PUBLIC_TURNSTILE_SITE_KEY). Leave unset to disable the captcha.
TURNSTILE_SECRET_KEY=

# Real client IP for rate limiting and audit logs. On Render (which sits behind
# Cloudflare) set CLIENT_IP_HEADER=cf-connecting-ip; otherwise every request
# looks like it comes from Render's internal load balancer. Only use a header
# your edge proxy always overwrites. Without it, TRUST_PROXY_HOPS (default 1)
# picks the address from X-Forwarded-For.
CLIENT_IP_HEADER=
TRUST_PROXY_HOPS=1

# Set to "production" in deployed environments: enables Secure cookies,
# rejects plain-HTTP requests, and turns off debug logging.
NODE_ENV=development
